{
  "compilerOptions": {
    "target": "ES2015",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist/backend",
    "moduleResolution": "node",
    "declaration": false
  },
  "include": ["src/backend/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
