# ========================================
# ana.env.example — template for the user-level env file
# ========================================
# Copy to ~/.ana/ana.env on EVERY machine that runs Ana (this Lenovo,
# the 32-bit Atom boxes, any future host) and fill in real values:
#
#   mkdir -p ~/.ana
#   cp ana.env.example ~/.ana/ana.env
#   nano ~/.ana/ana.env        # paste real keys
#   chmod 600 ~/.ana/ana.env   # keep secrets private
#
# WHY NOT .env? The freebuff CLI crashes on this machine and the Atom
# boxes whenever a .env* file exists in the project CWD — it calls
# statx(), which is missing on their kernels (< 4.11). env.js loads this
# file from your HOME directory instead, so the project CWD stays clean
# and the crash never triggers. Real environment variables (shell export,
# init script, Docker, CI) always take precedence over this file.
# ========================================

# Required — Groq LLM API key (the persuasion phase needs it)
GROQ_API_KEY="gsk_..."

# Optional — all config.js ANA_* overrides work here too
# ANA_MODEL="llama-3.3-70b-versatile"
# ANA_TEMPERATURE="0.2"
# ANA_MAX_MSGS_PER_HOUR="15"
# ANA_ACTIVE_HOURS_START="7"
# ANA_ACTIVE_HOURS_END="14"

# Optional — deployment paths (defaults are project-root-relative)
# CSV_OUTPUT_PATH="/home/metropolis3/Documents/real-estate-atoms/secretaries/outbound_final/data/collected-leads.csv"
# LOG_PATH=""
# METRICS_PATH=""
# HEALTH_PORT="8081"
